#!/usr/bin/env python3
"""Compare direct logit probes with native server probabilities on a real model."""
import json
from pathlib import Path
import sys
sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
import numpy as np
from neuron.backend import ROOT, Server, write_json, verify_build

lock=json.loads((ROOT/'models.lock.json').read_text())
build=verify_build()
output=ROOT/'runs/logprob-integration-final'
with Server(ROOT/'models'/lock['filename'],output) as server:
    results=[]
    for prompt in ['Name an ordinary household item.', 'Complete the sentence about something in a home.']:
        baseline,(means,norms,_)=server.complete(prompt,tokens=1,temperature=0,trace=True)
        native=baseline['completion_probabilities'][0]['top_logprobs']
        ids=[p['id'] for p in native]
        response,_=server.complete(prompt,tokens=1,temperature=0,logit_tokens=ids)
        ours=response['neuron_logprobs'][-1]
        differences=np.array([ours[x['id']]-x['logprob'] for x in native])
        # Native softmax accumulates in float; the probe uses double log-sum-exp.
        assert np.max(np.abs(differences))<1e-3
        assert np.ptp(differences)<2e-5
        assert len(means)==31 and len(norms)==32 and norms[31]
        zero,_=server.complete(prompt,tokens=1,temperature=0,logit_tokens=ids,
                               steering=[dict(layer=31,neuron=1103,alpha=0)])
        changed,_=server.complete(prompt,tokens=1,temperature=0,logit_tokens=ids,
                                  steering=[dict(layer=31,neuron=1103,alpha=5)])
        reset,_=server.complete(prompt,tokens=1,temperature=0,logit_tokens=ids)
        assert zero['neuron_logprobs']==response['neuron_logprobs']==reset['neuron_logprobs']
        assert changed['neuron_logprobs']!=response['neuron_logprobs']
        results.append(dict(prompt=prompt,max_absolute_error=float(np.max(np.abs(differences))),
                            pairwise_log_odds_error=float(np.ptp(differences)),
                            final_layer_zero_and_reset_exact=True,final_layer_nonzero_changes_logits=True))
    write_json(output/'result.json',dict(status='pass',build=build,results=results))
    print(json.dumps(results,indent=2))
